{
    "version": 2,
    "uploaders": {
        "personal": {
            "request": {
                "method": "POST",
                "url": "https://upload.example.com/api/upload",
                "headers": {},
                "query": {},
                "body": "multipart",
                "fileField": "file",
                "fields": {}
            },
            "response": {
                "url": {
                    "type": "json",
                    "path": "$.data.url"
                },
                "error": {
                    "type": "json",
                    "path": "$.error"
                }
            }
        },
        "binary-header": {
            "request": {
                "method": "PUT",
                "url": "https://upload.example.com/api/raw",
                "headers": {
                    "Content-Type": "application/octet-stream"
                },
                "query": {},
                "body": "binary"
            },
            "response": {
                "url": {
                    "type": "header",
                    "header": "Location"
                },
                "error": {
                    "type": "body"
                }
            }
        },
        "form-text": {
            "request": {
                "method": "POST",
                "url": "https://upload.example.com/api/form",
                "headers": {},
                "query": {},
                "body": "form",
                "fields": {
                    "content": "{input}",
                    "visibility": "private"
                }
            },
            "response": {
                "url": {
                    "type": "body"
                },
                "error": {
                    "type": "body"
                }
            }
        },
        "json-text": {
            "request": {
                "method": "POST",
                "url": "https://upload.example.com/api/json",
                "headers": {},
                "query": {},
                "body": "json",
                "data": {
                    "content": "{input}",
                    "metadata": {
                        "source": "upit"
                    }
                }
            },
            "response": {
                "url": {
                    "type": "regex",
                    "pattern": "(https://files.example.com/[A-Za-z0-9_-]+)",
                    "group": "1"
                },
                "error": {
                    "type": "json",
                    "path": "$.error"
                }
            }
        }
    }
}

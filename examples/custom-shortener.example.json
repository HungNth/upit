{
    "version": 1,
    "shorteners": {
        "shortened": {
            "request": {
                "method": "POST",
                "url": "https://example.com/api/v2/links",
                "headers": {
                    "X-API-KEY": "YOUR_API_KEY"
                },
                "query": {},
                "data": {
                    "target": "{input}"
                }
            },
            "response": {
                "url": {
                    "type": "json",
                    "path": "$.link"
                },
                "error": {
                    "type": "json",
                    "path": "$.error"
                }
            }
        }
    }
}
